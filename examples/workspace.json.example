{
  "_comment": "Copy this file to workspace.json in the workspace where you run skills. Replace every REPLACE_WITH_ value. Never commit workspace.json. Relative paths are from that workspace. Knowledge-intake path defaults match that plugin's layout. slack_source is optional and may stay empty. agent_queue_source is the queue daily-plan hands agent work to. inbox_source is the email inbox (Gmail is the example). Leadership source kinds live under sources. leadership.coaching_briefs_dir may stay empty, which means do not save briefs. workspace.timezone is optional for skills that mark it optional.",
  "workspace_id": "personal",
  "workspace_root": ".",
  "workspace": {
    "timezone": "REPLACE_WITH_IANA_TIMEZONE"
  },
  "raw_dir": "learnings/raw",
  "loop_state": ".agents/loops/knowledge-intake.json",
  "podcast_feeds": "skills/capture-podcasts/references/feeds.json",
  "youtube_channels": "skills/capture-youtube/references/channels.json",
  "newsletter_sources": "REPLACE_WITH_NEWSLETTER_SOURCES",
  "calendar_source": "REPLACE_WITH_CALENDAR",
  "meeting_lookback": "REPLACE_WITH_LOOKBACK_WINDOW",
  "inbox_source": "REPLACE_WITH_INBOX",
  "slack_source": "",
  "priorities_source": "REPLACE_WITH_PRIORITIES_LIST",
  "week_snapshot_source": "REPLACE_WITH_WEEK_SNAPSHOT",
  "work_queue_source": "REPLACE_WITH_WORK_QUEUE",
  "agent_queue_source": "REPLACE_WITH_AGENT_QUEUE",
  "sources": {
    "transcripts.meetings": {
      "via": "skill",
      "skill": "capture-meetings",
      "target": "output=raw"
    },
    "transcripts.one-on-ones": {
      "via": "file",
      "path": "REPLACE_WITH_ONE_ON_ONE_FOLDER"
    },
    "people.roster": {
      "via": "file",
      "path": "REPLACE_WITH_ROSTER_FILE"
    },
    "people.assessments": {
      "via": "file",
      "path": "REPLACE_WITH_ASSESSMENT_FILE"
    },
    "people.profiles": {
      "via": "connector",
      "connector": "REPLACE_WITH_PROFILE_CONNECTOR",
      "target": "REPLACE_WITH_DISC_FIELD"
    },
    "log.open-items": {
      "via": "file",
      "path": "leadership/open-items.json"
    },
    "tasks.commitments": [
      {
        "via": "file",
        "path": "REPLACE_WITH_COMMITMENTS_FILE"
      }
    ]
  },
  "leadership": {
    "coaching_state": ".agents/loops/coaching-angles.json",
    "coaching_briefs_dir": ""
  },
  "wiki_ingest_skill": "wiki-ingest",
  "notion_raw_db": {
    "name": "Raw",
    "id": "REPLACE_WITH_YOUR_NOTION_RAW_DATABASE_ID"
  },
  "notion_wiki_db": {
    "name": "Wiki",
    "id": "REPLACE_WITH_YOUR_NOTION_WIKI_DATABASE_ID"
  },
  "notion_wiki_log": {
    "name": "Wiki Log",
    "id": "REPLACE_WITH_YOUR_NOTION_WIKI_LOG_ID"
  },
  "guardrails": {
    "max_podcast_items_per_run": 2,
    "max_meeting_artifacts_per_run": 2,
    "max_audio_minutes_per_run": 180
  },
  "routing_policy": {
    "accept": [
      "personal learning",
      "research",
      "writing",
      "ideas",
      "life administration",
      "side projects"
    ],
    "reject": [
      "work operations",
      "client support tickets",
      "confidential personnel",
      "partner meetings marked confidential"
    ],
    "on_ambiguous": "defer"
  },
  "schema_categories": [
    "sources",
    "topics",
    "systems",
    "projects",
    "ideas",
    "people",
    "decisions",
    "brands",
    "positions",
    "clients"
  ]
}
