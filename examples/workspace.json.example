{
  "_comment": "Copy this file to workspace.json in the workspace where you run skills. Replace every REPLACE_WITH_ value. Never commit workspace.json. Relative paths are from that workspace. Knowledge-intake path defaults match that plugin's layout. slack_source is optional and may stay empty. agent_queue_source is the queue daily-plan hands agent work to. inbox_source is the email inbox (Gmail is the example).",
  "workspace_id": "personal",
  "workspace_root": ".",
  "raw_dir": "learnings/raw",
  "loop_state": ".agents/loops/knowledge-intake.json",
  "podcast_feeds": "skills/capture-podcasts/references/feeds.json",
  "youtube_channels": "skills/capture-youtube/references/channels.json",
  "newsletter_sources": "REPLACE_WITH_NEWSLETTER_SOURCES",
  "calendar_source": "REPLACE_WITH_CALENDAR",
  "meeting_lookback": "REPLACE_WITH_LOOKBACK_WINDOW",
  "inbox_source": "REPLACE_WITH_INBOX",
  "slack_source": "",
  "priorities_source": "REPLACE_WITH_PRIORITIES_LIST",
  "week_snapshot_source": "REPLACE_WITH_WEEK_SNAPSHOT",
  "work_queue_source": "REPLACE_WITH_WORK_QUEUE",
  "agent_queue_source": "REPLACE_WITH_AGENT_QUEUE",
  "wiki_ingest_skill": "wiki-ingest",
  "notion_raw_db": {
    "name": "Raw",
    "id": "REPLACE_WITH_YOUR_NOTION_RAW_DATABASE_ID"
  },
  "notion_wiki_db": {
    "name": "Wiki",
    "id": "REPLACE_WITH_YOUR_NOTION_WIKI_DATABASE_ID"
  },
  "notion_wiki_log": {
    "name": "Wiki Log",
    "id": "REPLACE_WITH_YOUR_NOTION_WIKI_LOG_ID"
  },
  "guardrails": {
    "max_podcast_items_per_run": 2,
    "max_meeting_artifacts_per_run": 2,
    "max_audio_minutes_per_run": 180
  },
  "routing_policy": {
    "accept": [
      "personal learning",
      "research",
      "writing",
      "ideas",
      "life administration",
      "side projects"
    ],
    "reject": [
      "work operations",
      "client support tickets",
      "confidential personnel",
      "partner meetings marked confidential"
    ],
    "on_ambiguous": "defer"
  },
  "schema_categories": [
    "sources",
    "topics",
    "systems",
    "projects",
    "ideas",
    "people",
    "decisions",
    "brands",
    "positions",
    "clients"
  ]
}
