{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hosting-snapshot.v1",
  "title": "Hosting snapshot, version 1",
  "description": "One site, one month of hosting measurements. Written by hosting-metrics-collect, read by hosting-snapshot-diff. Every measured section is null when its source was unavailable or failed; the reason is in sources. A number is never guessed.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "siteId",
    "domain",
    "month",
    "collectedAt",
    "sources",
    "uptime",
    "ttfb",
    "pagespeed",
    "ssl",
    "domainRegistration",
    "server",
    "backups",
    "billing",
    "errors"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "hosting-snapshot"
    },
    "version": {
      "const": 1
    },
    "siteId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "domain": {
      "type": "string"
    },
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
      "description": "The month the report covers."
    },
    "collectedAt": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO time the collector ran (UTC). Informational only, never used in copy."
    },
    "sources": {
      "type": "object",
      "description": "Status of every source. Keys: uptimerobot, pagespeed, ttfb, ssl, rdap, forge, forgeBackups, stripe, plus any extra sources.",
      "properties": {
        "uptimerobot": {
          "$ref": "#/$defs/source"
        },
        "pagespeed": {
          "$ref": "#/$defs/source"
        },
        "ttfb": {
          "$ref": "#/$defs/source"
        },
        "ssl": {
          "$ref": "#/$defs/source"
        },
        "rdap": {
          "$ref": "#/$defs/source"
        },
        "forge": {
          "$ref": "#/$defs/source"
        },
        "forgeBackups": {
          "$ref": "#/$defs/source"
        },
        "stripe": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "uptime": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "pct",
        "incidents",
        "downMinutes",
        "incidentDays"
      ],
      "additionalProperties": false,
      "properties": {
        "pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "incidents": {
          "type": "integer",
          "minimum": 0
        },
        "downMinutes": {
          "type": "integer",
          "minimum": 0
        },
        "incidentDays": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          }
        }
      }
    },
    "ttfb": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "medianSec",
        "runsSec"
      ],
      "additionalProperties": false,
      "properties": {
        "medianSec": {
          "type": "number",
          "minimum": 0
        },
        "runsSec": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      }
    },
    "pagespeed": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "score",
        "runs",
        "lcpSec",
        "cls",
        "tbtMs"
      ],
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Median mobile performance score of the runs."
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "lcpSec": {
          "type": [
            "number",
            "null"
          ]
        },
        "cls": {
          "type": [
            "number",
            "null"
          ]
        },
        "tbtMs": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "ssl": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "expires",
        "daysLeft",
        "issuer",
        "issuedOn"
      ],
      "additionalProperties": false,
      "properties": {
        "expires": {
          "$ref": "#/$defs/date"
        },
        "daysLeft": {
          "type": "integer"
        },
        "issuer": {
          "type": "string"
        },
        "issuedOn": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "domainRegistration": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "expires",
        "daysLeft",
        "registrar"
      ],
      "additionalProperties": false,
      "properties": {
        "expires": {
          "$ref": "#/$defs/date"
        },
        "daysLeft": {
          "type": "integer"
        },
        "registrar": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "server": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "name",
        "connected",
        "php",
        "ubuntu",
        "diskPct",
        "securityUpdates",
        "siteStatus",
        "lastDeploy"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "connected": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "php": {
          "type": [
            "string",
            "null"
          ]
        },
        "ubuntu": {
          "type": [
            "string",
            "null"
          ]
        },
        "diskPct": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "securityUpdates": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "siteStatus": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastDeploy": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "date",
            "ok"
          ],
          "properties": {
            "date": {
              "$ref": "#/$defs/date"
            },
            "ok": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "backups": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "ok",
        "total",
        "daysMissed",
        "restoreTest"
      ],
      "additionalProperties": false,
      "properties": {
        "ok": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "daysMissed": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "restoreTest": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "date",
            "passed"
          ],
          "properties": {
            "date": {
              "$ref": "#/$defs/date"
            },
            "passed": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "billing": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "state",
        "invoiceDate",
        "amount",
        "currency",
        "subscriptionStatus"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "paid",
            "processing",
            "failed",
            "none"
          ],
          "description": "paid: invoice paid. processing: payment pending (for example ACH). failed: payment failed or invoice past due. none: no invoice for the month."
        },
        "invoiceDate": {
          "type": [
            "string",
            "null"
          ]
        },
        "amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "subscriptionStatus": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "errors": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "errors5xx",
        "brokenPages"
      ],
      "additionalProperties": false,
      "description": "Error pages visitors hit. No built-in collector yet; filled only when another source provides it.",
      "properties": {
        "errors5xx": {
          "type": "integer",
          "minimum": 0
        },
        "brokenPages": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ok",
            "unavailable",
            "error"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
